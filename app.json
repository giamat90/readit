{
  "expo": {
    "name": "ReadIt",
    "slug": "readit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "readit",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giamat90.readit"
    },
    "android": {
      "package": "com.giamat90.readit",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#283A5F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "./plugins/withReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReadIt reads text from photos you choose.",
          "cameraPermission": "ReadIt reads text from photos you take."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
